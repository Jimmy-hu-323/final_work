# Core services
QWENPAW_HOST=127.0.0.1
QWENPAW_PORT=18088
QWENPAW_AGENT_ID=lensgo-travel-director
QWENPAW_PROVIDER_ID=aliyun-tokenplan-intl-custom
QWENPAW_MODEL_ID=qwen3.7-plus
# Android/Tauri 客户端来源；公网部署请使用反向代理、HTTPS 和 QwenPaw 登录鉴权
QWENPAW_CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
LENSGO_CORS_ORIGINS=*

# Pose reference image generation
# DashScope examples (the API key and endpoint must be from the same region):
# China:         https://dashscope.aliyuncs.com/api/v1
# International: https://dashscope-intl.aliyuncs.com/api/v1
POSE_IMAGE_PROVIDER=dashscope
POSE_IMAGE_API_KEY=
POSE_IMAGE_BASE_URL=
POSE_IMAGE_MODEL=wan2.6-t2i
POSE_IMAGE_SIZE=1280*1280
POSE_IMAGE_TIMEOUT_SECONDS=180

# OpenRouter alternative (uses its dedicated /api/v1/images endpoint):
# POSE_IMAGE_PROVIDER=openrouter
# POSE_IMAGE_API_KEY=                 # optional when OPENROUTER_API_KEY exists locally
# POSE_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# POSE_IMAGE_MODEL=openai/gpt-image-1
# POSE_IMAGE_SIZE=1024x1024

# LensGo Bridge / Telegram (leave blank to keep the corresponding integration unavailable)
GLASSES_BRIDGE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STATUS_BOT_TOKEN=
TELEGRAM_STATUS_CHAT_ID=

# Optional external AMap MCP; paths may be absolute or relative to this project root
AMAP_MCP_SERVER=
AMAP_CONFIG_FILE=

# Optional external AI Drive MCP and backend
AI_DRIVE_MCP_SERVER=
AI_DRIVE_BASE_URL=http://127.0.0.1:8000
AI_DRIVE_TIMEOUT_SECONDS=60

# LensGo publish crowd API (read-only MCP used by the travel director)
LENSGO_CROWD_PROJECT_ROOT=
LENSGO_CROWD_BASE_URL=http://127.0.0.1:18099
LENSGO_CROWD_READ_TOKEN=
LENSGO_CROWD_TIMEOUT_SECONDS=8
LENSGO_CROWD_STALE_MINUTES=30

# Hotel booking / trip-expense service (path may be absolute or relative to this project root)
HOTEL_BOOKING_BASE_URL=http://127.0.0.1:18110
HOTEL_BOOKING_ENV_FILE=..\hotel_book\.dev.vars

# Enable this only when QwenPaw is exposed through a trusted HTTPS reverse proxy.
# Loopback requests remain available to the local LensGo bridge.
QWENPAW_AUTH_ENABLED=false

# Runtime
PYTHONUTF8=1
