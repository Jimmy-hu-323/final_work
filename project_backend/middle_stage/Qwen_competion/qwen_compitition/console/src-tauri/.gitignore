# Generated by Cargo
# will have compiled files and executables
/target/
# Keep the initialized Android project because LensGo adds a foreground
# runtime service and Android permissions that are product source, not build
# output. The nested Android .gitignore still excludes Gradle caches, local
# SDK paths, generated Tauri bindings, native libraries, and signing files.
/gen/*
!/gen/android/
!/gen/android/**
tauri.version.conf.json

# Generated PyInstaller backend sidecar copied by pack-tauri scripts.
/binaries/
