# 复制为 .env.bridge 后填写。该文件已被 Git 忽略。

# 必填：保护数据 Bridge API。可用 `openssl rand -hex 32` 生成。
GLASSES_BRIDGE_TOKEN="replace-with-a-random-token"

# LensGo 大使：生活化对话、照片和最终回复，可从 Telegram 对话。
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# LensGo 工作台：设备、Router、多 Agent 协作和错误，只读。
TELEGRAM_STATUS_BOT_TOKEN=""
TELEGRAM_STATUS_CHAT_ID=""
