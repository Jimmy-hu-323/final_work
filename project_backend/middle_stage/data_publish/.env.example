# 复制成 .env 后填写。.env 已被 .gitignore 忽略，不要提交或发送给他人。

# 至少 32 字节随机值。用于 HMAC 会话、CSRF 与 API Key 摘要；正式部署必填。
CROWD_AUTH_MODE=required
CROWD_AUTH_PEPPER=
CROWD_SESSION_COOKIE_SECURE=false
CROWD_SESSION_TTL_SECONDS=28800
CROWD_SESSION_IDLE_SECONDS=1800
CROWD_API_KEY_TOUCH_SECONDS=60

# 高德「Web服务」Key，仅 publisher/admin 可通过服务端代理使用。
AMAP_WEB_KEY=
AMAP_TIMEOUT_SECONDS=8

CROWD_HOST=127.0.0.1
CROWD_PORT=18099
CROWD_CORS_ORIGINS=http://127.0.0.1:18099,http://localhost:18099,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# 仅旧版本迁移期使用；新部署保持为空。
CROWD_READ_TOKEN=
CROWD_WRITE_TOKEN=
