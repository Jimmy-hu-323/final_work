# Nested repositories keep their own history; never version their metadata.
**/.git/
**/.git.nested-backup-codex-v3/

# Secrets and machine-local configuration.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.dev.vars
**/*credential*.yaml
**/*credential*.yml
**/*public-access*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Runtime data, databases and private workspaces.
**/.venv/
**/.venv-linux/
**/venv/
**/workspace/logs/
**/workspace/runtime/
**/workspace/qwenpaw/
**/workspace/qwenpaw.secret/
**/workspace/legacy-path-artifacts/
**/data/uploads/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.rdb

# Dependencies, caches and build outputs.
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/
**/*.py[cod]
**/*.egg-info/
**/.next/
**/.vinext/
**/.vite/
**/.wrangler/
**/dist/
**/dist-mobile/
**/build/
**/target/
**/coverage/
**/.gradle/
**/*.tsbuildinfo
**/*.apk
**/*.aab
**/*.ipa
**/*.so

# Logs, editors, archives and recovery copies.
**/*.log
**/*.zip
**/*.tar.gz
**/*.tmp
**/*.pending
**/*.bak
**/*.bak-*
**/*.bak.*
**/*.pre-*
**/.recovery-*/
**/.idea/
**/.vscode/
**/.cursor/
**/.codex/
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
